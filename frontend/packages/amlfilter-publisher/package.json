{
	"name": "@amlfilter/publisher",
	"private": true,
	"version": "4.0.0",
	"license": "MIT",
	"type": "module",
	"description": "Node-side OFAC/EU/UN/UK publisher: validates required feeds, precomputes name vectors, and emits the signed content-addressed bundle the browser delta-syncs.",
	"exports": {
		".": "./src/index.ts"
	},
	"bin": {
		"amlfilter-publish": "./src/cli.ts"
	},
	"scripts": {
		"lint": "biome check .",
		"typecheck": "tsc -b",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"publish": "vite-node src/cli.ts --",
		"build-real-bundle": "vite-node src/buildRealBundleMain.ts --",
		"build-recall-fixture": "vite-node src/recall/buildRecallFixtureMain.ts",
		"measure-recall": "vite-node src/recall/measureRecallMain.ts --",
		"gate:recall": "vite-node src/recall/measureRecallMain.ts",
		"emit-decision": "vite-node src/decision/emitDecisionMain.ts --",
		"gate:decision": "vite-node src/decision/emitDecisionMain.ts && uv run --project ../../../eval python -m amlfilter_eval check",
		"measure-decision": "vite-node src/decision/emitDecisionMain.ts && uv run --project ../../../eval python -m amlfilter_eval write",
		"build-demo-bundle": "vite-node src/buildDemoBundle.ts",
		"build-demo-bundle-v2": "vite-node src/buildDemoBundleV2.ts",
		"next-published-sequence": "vite-node src/nextPublishedSequenceMain.ts --",
		"verify-published-origin": "vite-node src/verifyPublishedOriginMain.ts --",
		"mirror-published-origin": "vite-node src/mirrorPublishedOriginMain.ts --",
		"sync-live-bundle": "vite-node src/syncLiveBundleMain.ts --",
		"check-published-freshness": "vite-node src/checkPublishedFreshnessMain.ts --",
		"snapshot": "vite-node src/snapshotSourcesMain.ts --"
	},
	"dependencies": {
		"@amlfilter/browser": "workspace:*",
		"@edgeproc/browser": "github:hseshadr/edgeproc-browser#edd99713ddf6e700c384f8981dcfc25341cc20a7",
		"@huggingface/transformers": "4.2.0",
		"@noble/ed25519": "^3.2.0",
		"undici": "7.29.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/node": "^26.6.3",
		"@vitest/coverage-v8": "^5.0.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.1",
		"vite-node": "^6.0.0",
		"vitest": "^5.0.3"
	}
}
