# Cloudflare Pages response headers (pattern line, then indented `Name: Value` lines).
#
# Browser-validated security baseline. We deliberately do NOT set:
#   - Cross-Origin-Embedder-Policy (COEP) / Cross-Origin-Opener-Policy (COOP):
#     the signed watchlist bundle is now served SAME-ORIGIN from /bundle/origin,
#     so cross-origin isolation buys nothing; left off to avoid regressions.
# CSP permits only the exact capabilities the zero-server app needs: same-origin
# scripts/data, WebAssembly compilation, and its module workers. The one sha256
# source is the static JSON-LD block in index.html; executable inline script and
# arbitrary eval remain blocked.
#
# HSTS: aml-filter.com is served HTTPS-only via Cloudflare Pages, so pin HTTPS for
# a year (and cover subdomains) to close the first-visit SSL-strip / downgrade
# window. This is purely additive — it constrains the TRANSPORT, never what the
# app is allowed to load — so it cannot break the WASM / worker / same-origin
# bundle screen path the way a wrong CSP/COEP would.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-bPhkKrTfNERJVi9ooeErpO86sPJj58qQr6rRruVJbXU='; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; child-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests

# The mutable pointer is always revalidated by the client and must never be
# cached by an intermediary. Its referenced manifest/chunks are named by their
# plaintext SHA-256, so those immutable representations are safe to cache forever.
/bundle/origin/latest
  Cache-Control: no-store
  Content-Type: application/json; charset=utf-8
/bundle/origin/manifest/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/json; charset=utf-8
/bundle/origin/chunk/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/octet-stream

# Exact deployment identity is mutable per release and must pierce edge/browser
# caches so the post-deploy no-op/stale check observes the current artifact.
/build.json
  Cache-Control: no-store
  Content-Type: application/json; charset=utf-8

# Raw Ed25519 key bytes. nosniff makes the explicit binary MIME essential.
/public.key
  Content-Type: application/octet-stream
  Cache-Control: no-cache, must-revalidate

# The ~23 MB MiniLM model (+ tokenizer/config JSONs) under /models/ is pinned by
# SHA-256 at build time (scripts/download-model.mjs) and never mutates in place,
# so a year-long immutable cache is safe. Without this rule Pages serves the
# model with `max-age=0, must-revalidate` (and no Content-Length), forcing a
# full re-download on every visit. A future weights bump must re-pin the digests
# AND move the files to a new URL path — these URLs are cached as immutable.
# Pages applies every matching block, so /models/* responses still carry the /*
# security headers above.
/models/*
  Cache-Control: public, max-age=31536000, immutable
