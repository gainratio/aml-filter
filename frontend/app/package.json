{
	"name": "aml-filter-app",
	"version": "4.0.0",
	"description": "Free sanctions screening for small businesses: check a customer's name against government lists, in your browser.",
	"type": "module",
	"private": true,
	"scripts": {
		"stage:assets": "node scripts/download-model.mjs && node scripts/gen-demo-stats.mjs && node scripts/stage-ort-wasm.mjs",
		"dev": "pnpm run stage:assets && vite",
		"bundle:live": "pnpm --filter @amlfilter/publisher run sync-live-bundle",
		"dev:live": "pnpm run bundle:live && pnpm run stage:assets && vite --mode live",
		"build:live": "pnpm run bundle:live && pnpm run stage:assets && tsc --noEmit && vite build --mode live",
		"download-model": "node scripts/download-model.mjs",
		"gen:stats": "node scripts/gen-demo-stats.mjs",
		"prebuild": "pnpm run stage:assets",
		"build": "tsc --noEmit && vite build",
		"test:contract": "node --test scripts/canonical-worker.test.mjs",
		"preview": "vite preview",
		"lint": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"pretest": "pnpm run download-model && node scripts/gen-demo-stats.mjs",
		"test": "vitest run",
		"pretest:coverage": "pnpm run download-model && node scripts/gen-demo-stats.mjs",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:receipt": "playwright test tests/score-receipt-browser.spec.ts",
		"test:e2e:c1": "playwright test -c playwright.c1.config.ts",
		"test:e2e:kyc": "playwright test -c playwright.kyc.config.ts",
		"test:e2e:bundle": "playwright test -c playwright.bundle.config.ts",
		"test:e2e:live": "playwright test -c playwright.live.config.ts",
		"test:e2e:mobile": "playwright test -c playwright.mobile.config.ts",
		"test:e2e:mobile:ci": "playwright test -c playwright.mobile.config.ts --project=ios-webkit --project=android-chromium --project=desktop-control",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:report": "playwright show-report",
		"verify:i18n": "node scripts/verify-i18n.mjs"
	},
	"dependencies": {
		"@amlfilter/browser": "workspace:*",
		"@amlfilter/workstation": "workspace:*",
		"@edgeproc/errors": "^0.1.2",
		"@edgeproc/receipt-ui": "0.2.0",
		"@hpcc-js/wasm-zstd": "^1.16.1",
		"@huggingface/transformers": "4.2.0",
		"@noble/ed25519": "^3.2.0",
		"i18next": "^26.4.2",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-i18next": "^17.0.14",
		"react-router": "^8.4.0",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@playwright/test": "^1.63.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"@vitest/coverage-v8": "^5.0.1",
		"jsdom": "^30.1.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	}
}
