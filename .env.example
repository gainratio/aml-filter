# aml-filter — optional build, test, and publisher environment variables.
#
# All variables are optional: a fresh clone runs with everything unset using the
# committed signed demo watchlist bundle.
#
# For SPA Vite overrides during local development or custom builds, copy
# `frontend/app/.env.example` to `frontend/app/.env` (Vite reads `.env` from
# `frontend/app/`):
#   cp frontend/app/.env.example frontend/app/.env

# --- SPA build-time Vite variables (read from `frontend/app/.env`) ---

# Base URL where the signed, content-addressed watchlist bundle is served.
# Default (unset): same-origin "/bundle/origin".
# VITE_BUNDLE_BASE_URL=https://cdn.example.com

# Max idle window (ms) with zero download progress during MiniLM model warmup.
# Default (unset): 90000.
# VITE_MODEL_LOAD_IDLE_TIMEOUT_MS=90000

# Whole-bootstrap ceiling (ms) covering bundle sync, signature check, and warmup.
# Default (unset): 900000.
# VITE_BOOT_TIMEOUT_MS=900000

# --- Publisher & local verification scripts (Node CLI, not exposed to browser) ---

# Optional port override for `frontend/app/scripts/verify-i18n.mjs`.
# VERIFY_I18N_PORT=4173

# Optional overrides when packing fresh watchlists with `amlfilter-publisher`:
# OFAC_BASE=https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports
# EDGEPROC_DIR=
